rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /{collection}/{recordId} {
      allow read: if signedIn()
        && collection in [
          "employees",
          "attrition",
          "allocations",
          "attendance",
          "projects",
          "auditLogs"
        ];

      allow write: if isAdmin()
        && collection in [
          "employees",
          "attrition",
          "allocations",
          "attendance",
          "projects",
          "auditLogs"
        ];
    }
  }
}
